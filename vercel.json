{
  "redirects": [
    {
      "source": "/:path((?!api/|g/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.statchat.co"
        }
      ],
      "destination": "https://statchat.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/g/:token",
      "destination": "/api/share?t=:token"
    }
  ]
}
